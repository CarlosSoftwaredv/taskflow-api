# Copie para .env para personalizar a configuração local do Docker.
# Os valores abaixo são exclusivos para desenvolvimento local.
APP_ENV=development
API_PORT=8000
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow_user
MYSQL_PASSWORD=taskflow_pass
SECRET_KEY=local-development-only-change-before-deploy
MFA_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:8000
# SMTP delivery for email confirmation (TLS/STARTTLS; use a dedicated mail provider account)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Generate a long random secret (at least 32 characters) for /database access
DATABASE_VIEWER_KEY=
