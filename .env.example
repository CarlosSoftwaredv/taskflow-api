# Copie para .env para personalizar a configuração local do Docker.
# Os valores abaixo são exclusivos para desenvolvimento local.
APP_ENV=development
API_PORT=8000
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow_user
MYSQL_PASSWORD=taskflow_pass
SECRET_KEY=local-development-only-change-before-deploy
